<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logic of the server without Windows dependencies: protocol, controller sessions, input mapping,
       firewall rules, presenter of the main window. Platform services are behind interfaces,
       so it is tested on any OS (tests/TruckRemoteServer.Tests). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TruckRemoteServer</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
